#!/usr/bin/env bash
set -Eeuo pipefail

export PATH="$HOME/.local/bin:$PATH"

for command_name in go goreleaser golangci-lint gopls; do
  if ! command -v "$command_name" >/dev/null; then
    printf 'Missing required tool %s; rerun .agents/setup.\n' "$command_name" >&2
    exit 1
  fi
done

printf 'Orb development tools are ready.\n'
